# Copy thành .env (cùng thư mục với docker-compose.yml) rồi điền giá trị thật.
# Mật khẩu/secret chỉ dùng chữ và số (nằm trong DATABASE_URL) — tạo nhanh: openssl rand -hex 32

POSTGRES_DB=karaoke_db
POSTGRES_USER=karaoke_user
POSTGRES_PASSWORD=doi-mat-khau-nay

JWT_SECRET=doi-chuoi-bi-mat-nay
JWT_REFRESH_SECRET=doi-chuoi-bi-mat-khac

# true khi truy cập qua HTTPS (có reverse proxy + SSL phía trước)
COOKIE_SECURE=false

# Để trống: chỉ trang của chính ứng dụng gọi được API. Liệt kê (cách nhau dấu phẩy) các
# tên miền khác cần gọi API, ví dụ https://a.example.com
CORS_ORIGINS=
# true để mở tài liệu API /api/docs (mặc định tắt)
SWAGGER_ENABLED=false

# Sao lưu tự động (service backup): mỗi ngày lúc 09:00 giờ Việt Nam vào backups/ và lên WebDAV.
# WEBDAV_URL là thư mục chứa bản sao lưu (thư mục cha phải có sẵn, thư mục cuối tự tạo), ví dụ
# Nextcloud: https://cloud.example.com/remote.php/dav/files/<tài khoản>/karaoke502
# Để trống WEBDAV_URL thì chỉ sao lưu vào backups/ trên máy chủ.
# Mật khẩu có ký tự đặc biệt ($, #, dấu cách...) thì đặt trong dấu nháy đơn: WEBDAV_PASSWORD='a$b #c'
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
# Số ngày giữ bản sao lưu trên WebDAV và trong backups/ (0 = giữ mãi)
WEBDAV_KEEP_DAYS=30
KEEP_DAYS=30
# Giờ sao lưu (cú pháp cron, giờ Việt Nam). Mặc định 09:00 hằng ngày.
BACKUP_CRON=0 9 * * *

# Cổng web trên máy chủ. Có Nginx phía trước thì dùng 127.0.0.1:3000 để cổng không lộ ra Internet
# (Docker mở cổng bỏ qua ufw). Xem DEPLOYMENT.md mục 3.
APP_PORT=3000
