DATABASE_URL="postgresql://user:password@localhost:5432/karaoke_db?schema=public"
PORT=4000
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
# true when the frontend is only served over HTTPS
COOKIE_SECURE=false
# Business day (11:30 -> 06:00) is computed in the server's local time zone
TZ=Asia/Ho_Chi_Minh
# Origins allowed to call the API from another site, comma-separated.
# Unset: any origin in development, none in production (same-origin /api)
# CORS_ORIGINS=https://kara.example.com
# Swagger at /api/docs is off in production unless this is true
# SWAGGER_ENABLED=false
# Khóa mã hóa mật khẩu/phiên Minvoice: 32 byte base64 (openssl rand -base64 32). Bắt buộc khi NODE_ENV=production.
EINVOICE_SECRET=""
