// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Schema changes go through `npx prisma migrate dev --name <change>`;
// never `db push` against a database that holds real data.

// Default "library" engine: runs inside the Node process. The "binary" engine
// starts a separate query-engine process and costs tens of MB of RAM more.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cơ sở. `code` ("cs1", ...) is what URLs and the `?branch=` API param use.
model Branch {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  name             String
  address          String?
  // MST, entered on the Cơ sở page: 10 digits or 10-3. Not unique: several
  // branches may belong to one company (spec 2026-10-01 §4).
  taxCode          String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  rooms            Room[]
  orders           Order[]
  categories       Category[]
  products         Product[]
  stockDocuments   StockDocument[]
  stockMovements   StockMovement[]
  fundTransactions FundTransaction[]
  billCounters     BillCounter[]
  prStaff          PrStaff[]
  prAttendances    PrAttendance[]
  prSessions       PrSession[]
  orderEvents      OrderEvent[]
  discountRequests DiscountRequest[]
  einvoiceConfig   EinvoiceConfig?
  einvoices        Einvoice[]
}

enum Role {
  CHAIN_MANAGER // Quản lý cao nhất — all branches
  BRANCH_MANAGER // Quản lý cơ sở
  CASHIER // Thu ngân
  STAFF // Nhân viên
  BOARD // Hội đồng quản trị — view only, all branches; may wipe data
}

// Floor duty of an employee; who can be picked as CSKH / phục vụ on a room.
enum StaffPosition {
  CSKH
  SERVER
}

// Every account is an employee. branchId is null only for CHAIN_MANAGER and BOARD.
// password is null until a manager activates the account (cannot log in).
model User {
  id                        Int               @id @default(autoincrement())
  username                  String            @unique
  password                  String?
  fullName                  String
  phone                     String?
  role                      Role              @default(STAFF)
  position                  StaffPosition?
  // Quản lý PR/KTV: may edit the branch's PR/KTV list and take their roll call,
  // whatever the role.
  managesPr                 Boolean           @default(false)
  branchId                  Int?
  branch                    Branch?           @relation(fields: [branchId], references: [id])
  active                    Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  ordersAsCSKH              Order[]           @relation("OrderCSKH")
  ordersAsServer            Order[]           @relation("OrderServer")
  ordersCreated             Order[]           @relation("OrderCreatedBy")
  ordersCheckedOut          Order[]           @relation("OrderCheckedOutBy")
  ordersCancelled           Order[]           @relation("OrderCancelledBy")
  ordersEdited              Order[]           @relation("OrderEditedBy")
  stockDocuments            StockDocument[]   @relation("StockDocumentCreatedBy")
  stockDocumentsCancelled   StockDocument[]   @relation("StockDocumentCancelledBy")
  stockMovements            StockMovement[]
  fundTransactions          FundTransaction[] @relation("FundTransactionCreatedBy")
  fundTransactionsCancelled FundTransaction[] @relation("FundTransactionCancelledBy")
  dataPurgeLogs             DataPurgeLog[]
  prAttendancesRecorded     PrAttendance[]    @relation("PrAttendanceRecordedBy")
  prSessionsCreated         PrSession[]       @relation("PrSessionCreatedBy")
  ordersTimeLocked          Order[]           @relation("OrderTimeLockedBy")
  orderEventsCreated        OrderEvent[]      @relation("OrderEventCreatedBy")
  discountRequestsSent      DiscountRequest[] @relation("DiscountRequestedBy")
  discountRequestsDecided   DiscountRequest[] @relation("DiscountDecidedBy")
  einvoiceConfigsUpdated    EinvoiceConfig[]  @relation("EinvoiceConfigUpdatedBy")
  einvoicesCreated          Einvoice[]        @relation("EinvoiceCreatedBy")
  einvoicesUpdated          Einvoice[]        @relation("EinvoiceUpdatedBy")
  einvoicesIssued           Einvoice[]        @relation("EinvoiceIssuedBy")
  einvoicesNumberEdited     Einvoice[]        @relation("EinvoiceNumberEditedBy")

  @@index([branchId])
}

// PR/KTV of a branch. Not accounts (they never log in): a list kept by the
// PR managers (User.managesPr) and the branch/chain managers.
model PrStaff {
  id          Int            @id @default(autoincrement())
  branchId    Int
  branch      Branch         @relation(fields: [branchId], references: [id])
  code        String? // mã/số thẻ
  name        String
  phone       String?
  note        String?
  // false: left the venue; kept because the roll call references it.
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  attendances PrAttendance[]
  sessions    PrSession[]

  @@index([branchId])
}

// Điểm danh PR/KTV: one row per person per business day (check-in, and the
// check-out once they leave). Grows by one row per PR/KTV per working day
// (~50 × 5 branches × 365 ≈ 90k rows a year), kept like the other records.
model PrAttendance {
  id           Int       @id @default(autoincrement())
  branchId     Int
  branch       Branch    @relation(fields: [branchId], references: [id])
  prStaffId    Int
  prStaff      PrStaff   @relation(fields: [prStaffId], references: [id], onDelete: Cascade)
  businessDate DateTime  @db.Date
  checkInAt    DateTime
  checkOutAt   DateTime?
  note         String?
  createdById  Int?
  createdBy    User?     @relation("PrAttendanceRecordedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())

  @@unique([prStaffId, businessDate])
  @@index([branchId, businessDate])
}

// Một lượt PR/KTV ngồi trong một phòng đang hát. Không tính tiền trên hóa
// đơn, chỉ để thống kê giờ. Vài chục lượt mỗi cơ sở mỗi ngày (~100k dòng/năm
// cho cả chuỗi). Mỗi PR có tối đa một lượt đang mở: PrSessionsService giữ quy
// tắc này bằng khóa dòng PrStaff (Prisma 5 không biểu diễn được partial index).
model PrSession {
  id          Int       @id @default(autoincrement())
  branchId    Int
  branch      Branch    @relation(fields: [branchId], references: [id])
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  prStaffId   Int
  prStaff     PrStaff   @relation(fields: [prStaffId], references: [id])
  startAt     DateTime
  endAt       DateTime?
  createdById Int?
  createdBy   User?     @relation("PrSessionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([orderId]) // room page, checkout / cancel
  @@index([branchId, startAt]) // GET /pr/stats
  @@index([prStaffId, endAt]) // is this PR in another room?
}

model Category {
  id        Int       @id @default(autoincrement())
  branchId  Int
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([branchId])
}

model Product {
  id                 Int                 @id @default(autoincrement())
  branchId           Int
  branch             Branch              @relation(fields: [branchId], references: [id])
  name               String
  categoryId         Int?
  category           Category?           @relation(fields: [categoryId], references: [id])
  price              Decimal
  // Weighted average cost (giá vốn bình quân); changed only by stock
  // movements (InventoryService.applyMovement, inventory/costing.ts).
  costPrice          Decimal             @default(0)
  // Only changed through StockMovement (inventory documents, checkout).
  stockQuantity      Int                 @default(0)
  unit               String // e.g., lon, dia, gio
  // false for services (no stock deduction on checkout).
  trackStock         Boolean             @default(true)
  // Soft delete: OrderItem and stock history keep referencing the product.
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orderItems         OrderItem[]
  stockDocumentLines StockDocumentLine[]
  stockMovements     StockMovement[]

  @@index([branchId])
}

enum RoomStatus {
  AVAILABLE
  ACTIVE
  MAINTENANCE
}

model Room {
  id           Int        @id @default(autoincrement())
  branchId     Int
  branch       Branch     @relation(fields: [branchId], references: [id])
  name         String
  type         String     @default("VIP") // "VIP", "NORMAL"
  pricePerHour Decimal
  status       RoomStatus @default(AVAILABLE)
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([branchId])
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH // Tiền mặt
  TRANSFER // Chuyển khoản
}

model Order {
  id       Int         @id @default(autoincrement())
  branchId Int
  branch   Branch      @relation(fields: [branchId], references: [id])
  status   OrderStatus @default(PENDING)

  roomId Int?
  room   Room? @relation(fields: [roomId], references: [id])

  cskhId Int?
  cskh   User? @relation("OrderCSKH", fields: [cskhId], references: [id])

  serverId Int?
  server   User? @relation("OrderServer", fields: [serverId], references: [id])

  createdById    Int?
  createdBy      User? @relation("OrderCreatedBy", fields: [createdById], references: [id])
  checkedOutById Int?
  checkedOutBy   User? @relation("OrderCheckedOutBy", fields: [checkedOutById], references: [id])

  startTime DateTime?
  endTime   DateTime?

  // Hourly rate of the room when the session was opened; later room price
  // changes do not touch an open session.
  pricePerHour Decimal @default(0)

  // Financials. A percent > 0 wins over its amount; checkout stores the
  // amounts it actually applied (see billing.ts).
  totalProductPrice Decimal @default(0)
  hourlyFee         Decimal @default(0)

  discountPercent Float   @default(0)
  discountAmount  Decimal @default(0)

  hourlyDiscountPercent Float   @default(0)
  hourlyDiscountAmount  Decimal @default(0)

  serviceFeePercent Float   @default(0)
  serviceFeeAmount  Decimal @default(0)

  taxPercent Float   @default(10) // VAT 10% unless changed on the session
  taxAmount  Decimal @default(0)

  finalAmount Decimal @default(0)

  paymentMethod PaymentMethod?

  // Cancelling an open session, or voiding a paid bill (stock and the
  // fund receipt are reversed).
  cancelledAt   DateTime?
  cancelledById Int?
  cancelledBy   User?     @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?

  // Last correction of a paid bill by a manager (items, adjustments, times,
  // payment method); stock and the fund receipt follow the new amounts.
  editedAt   DateTime?
  editedById Int?
  editedBy   User?     @relation("OrderEditedBy", fields: [editedById], references: [id])
  editReason String?

  // Chốt giờ (phục vụ / thu ngân): the room fee is billed up to this moment
  // and checkout takes it as endTime. Null while the clock runs.
  timeLockedAt   DateTime?
  timeLockedById Int?
  timeLockedBy   User?     @relation("OrderTimeLockedBy", fields: [timeLockedById], references: [id])

  // Số hóa đơn (see orders/bill-number.ts), given when the bill is closed —
  // paid or cancelled — and kept when it is voided or corrected: DDMM of the business
  // day + 4-digit room code + the day's sequence in the branch.
  businessDate DateTime? @db.Date
  billSeq      Int?
  billNumber   String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           OrderItem[]
  prSessions      PrSession[]
  stockMovements  StockMovement[]
  fundTransaction FundTransaction?

  events           OrderEvent[]
  discountRequests DiscountRequest[]
  einvoices        Einvoice[]

  @@unique([branchId, businessDate, billSeq])
  @@index([branchId, status])
  @@index([branchId, startTime])
  @@index([branchId, endTime])
  @@index([branchId, billNumber])
  @@index([status, endTime])
}

// Last bill sequence handed out per branch and business day.
model BillCounter {
  branchId     Int
  branch       Branch   @relation(fields: [branchId], references: [id])
  businessDate DateTime @db.Date
  lastSeq      Int

  @@id([branchId, businessDate])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal // Price at the time of order
  // Cost per unit of what the bill took from stock (weighted average), set
  // at checkout and on corrections; 0 for products without stock tracking.
  unitCost  Decimal @default(0)

  @@index([orderId])
}

enum StockDocType {
  IMPORT // Phiếu nhập
  EXPORT // Phiếu xuất
}

model StockDocument {
  id              Int                 @id @default(autoincrement())
  branchId        Int
  branch          Branch              @relation(fields: [branchId], references: [id])
  type            StockDocType
  code            String              @unique // PN-cs1-20260926-001 / PX-...
  supplier        String?
  note            String?
  totalAmount     Decimal             @default(0)
  createdById     Int
  createdBy       User                @relation("StockDocumentCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  // Cancelling reverses the stock movements and the linked fund payment.
  cancelledAt     DateTime?
  cancelledById   Int?
  cancelledBy     User?               @relation("StockDocumentCancelledBy", fields: [cancelledById], references: [id])
  cancelReason    String?
  lines           StockDocumentLine[]
  movements       StockMovement[]
  fundTransaction FundTransaction?

  @@index([branchId, createdAt])
}

model StockDocumentLine {
  id         Int           @id @default(autoincrement())
  documentId Int
  document   StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int
  unitCost   Decimal       @default(0)
}

enum StockMovementType {
  IMPORT
  EXPORT
  SALE
  ADJUSTMENT
  REVERSAL // undoes a cancelled document / voided bill
}

// Stock ledger: every change of Product.stockQuantity writes one row.
model StockMovement {
  id           Int               @id @default(autoincrement())
  branchId     Int
  branch       Branch            @relation(fields: [branchId], references: [id])
  productId    Int
  product      Product           @relation(fields: [productId], references: [id])
  type         StockMovementType
  quantity     Int // signed: + in, - out
  balanceAfter Int
  // What one unit of the movement is valued at, and the product's weighted
  // average cost after it (inventory/costing.ts).
  unitCost     Decimal           @default(0)
  costAfter    Decimal           @default(0)
  documentId   Int?
  document     StockDocument?    @relation(fields: [documentId], references: [id])
  orderId      Int?
  order        Order?            @relation(fields: [orderId], references: [id])
  createdById  Int?
  createdBy    User?             @relation(fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  @@index([branchId, productId, createdAt])
  // What a bill took from stock: read at every checkout, void and correction
  @@index([orderId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

// Phiếu thu / phiếu chi of a branch's fund. Checkout writes the receipt of a
// bill (orderId) and an import paid from the fund writes its payment
// (stockDocumentId); those follow their source and cannot be cancelled here.
model FundTransaction {
  id              Int             @id @default(autoincrement())
  branchId        Int
  branch          Branch          @relation(fields: [branchId], references: [id])
  type            TransactionType
  method          PaymentMethod   @default(CASH)
  amount          Decimal
  category        String?
  description     String?
  occurredAt      DateTime        @default(now())
  orderId         Int?            @unique
  order           Order?          @relation(fields: [orderId], references: [id])
  stockDocumentId Int?            @unique
  stockDocument   StockDocument?  @relation(fields: [stockDocumentId], references: [id])
  createdById     Int?
  createdBy       User?           @relation("FundTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  // Cancelled entries stay in the book but are left out of every total.
  cancelledAt     DateTime?
  cancelledById   Int?
  cancelledBy     User?           @relation("FundTransactionCancelledBy", fields: [cancelledById], references: [id])
  cancelReason    String?

  @@index([branchId, occurredAt])
}

enum PurgeScope {
  BRANCH // one branch
  ALL // the whole system
}

// Nhật ký xóa dữ liệu (HĐQT): every purge, and every attempt refused for a
// wrong password. Never deleted by a purge. The account, branch and counts
// are copied so the entry reads the same whatever changes later.
model DataPurgeLog {
  id         Int        @id @default(autoincrement())
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  username   String
  fullName   String
  scope      PurgeScope
  // Snapshot of the branch wiped (scope BRANCH).
  branchCode String?
  branchName String?
  // false: refused (wrong password), nothing was deleted.
  success    Boolean
  // Rows deleted per table (success only).
  deleted    Json?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
}

// Rare events of a session kept for tracing (for now only unlocking the
// time). Locking lives on Order, so this grows only when someone unlocks:
// a few rows per branch per day. Kept like the books, wiped by the data purge.
model OrderEvent {
  id          Int            @id @default(autoincrement())
  branchId    Int
  branch      Branch         @relation(fields: [branchId], references: [id])
  orderId     Int
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        OrderEventType
  // TIME_UNLOCK: when the time had been locked.
  lockedAt    DateTime?
  createdById Int?
  createdBy   User?          @relation("OrderEventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())

  @@index([orderId])
}

enum OrderEventType {
  TIME_UNLOCK
}

// Every change of a bill's discounts / VAT: a cashier's request waiting for
// a manager, a change applied at once (a manager, or a change that needs no
// approval) and a correction of a paid bill. Both the approval queue and the
// audit trail. ~30 rows per branch per day (~55k/year for 5 branches); kept
// like the books, wiped by the data purge.
model DiscountRequest {
  id            Int                   @id @default(autoincrement())
  branchId      Int
  branch        Branch                @relation(fields: [branchId], references: [id])
  orderId       Int
  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        DiscountRequestStatus
  source        DiscountSource
  // {discountPercent, discountAmount, hourlyDiscountPercent, hourlyDiscountAmount, taxPercent}
  before        Json
  after         Json
  // The bill total (VAT included) when it was sent, before and after.
  amountBefore  Decimal
  amountAfter   Decimal
  note          String?
  requestedById Int?
  requestedBy   User?                 @relation("DiscountRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime              @default(now())
  decidedById   Int?
  decidedBy     User?                 @relation("DiscountDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?

  @@index([branchId, status])
  @@index([branchId, createdAt])
  @@index([orderId])
}

enum DiscountRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum DiscountSource {
  REQUEST
  DIRECT
  PAID_EDIT
}

// Hóa đơn điện tử (spec 2026-10-01).
enum EinvoiceStatus {
  DRAFT // Nháp: editable, has `draft`; with `lastError` the page shows "Lỗi"
  SENDING // Being sent to Minvoice
  UNCERTAIN // Unknown whether Minvoice created it: check before sending again
  ISSUED // Đã xuất: has its number, `draft` is null
}

// The Minvoice account and symbol of a branch. Apart from Branch because
// Branch is returned everywhere and this row holds secrets.
model EinvoiceConfig {
  id                Int       @id @default(autoincrement())
  branchId          Int       @unique
  branch            Branch    @relation(fields: [branchId], references: [id])
  // MST the account logged in with; differs from Branch.taxCode -> log in again.
  taxCode           String
  username          String
  // AES-256-GCM with EINVOICE_SECRET (einvoice-secret.ts); never returned or logged.
  passwordEnc       String
  // {cookie, token, userName} of the Minvoice session, encrypted the same way.
  sessionEnc        String?
  // Minvoice refused the stored password on a re-login; cleared by a login.
  loginError        String?
  symbolCode        String?
  // GUID of that symbol's current range (register-invoice/using-list).
  registerInvoiceId String?
  currencyId        String?
  // {legalName, address, email, tel, bankAccount, bankName, fax, website}
  seller            Json?
  loggedInAt        DateTime?
  updatedById       Int?
  updatedBy         User?     @relation("EinvoiceConfigUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// One small invoice of a paid bill. Its details (`draft`) live until it is
// issued; then only the header and Minvoice's number stay.
model Einvoice {
  id           Int            @id @default(autoincrement())
  branchId     Int
  branch       Branch         @relation(fields: [branchId], references: [id])
  // Null for a free invoice, made without a bill
  // (spec 2026-10-01-hddt-bo-cuc-va-hd-tu-do). Restrict keeps what the
  // column did when it was required: a bill with invoices is never deleted
  // (Prisma's default for an optional relation, SetNull, would turn its
  // invoices into free ones).
  orderId      Int?
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  // Copied from Order.businessDate so the list filters on its own index.
  businessDate DateTime       @db.Date
  status       EinvoiceStatus @default(DRAFT)
  // VAT included, typed by whoever creates it.
  amount       Decimal
  // Σ VAT of the lines, recomputed on every save.
  vatAmount    Decimal        @default(0)
  buyerTaxCode String?
  buyerName    String?
  // {buyerAddress, buyerEmail, lines[]} (einvoice-types.ts EinvoiceDraft).
  draft        Json?

  // Header, written when it is sent / issued.
  sellerTaxCode     String?
  symbolCode        String?
  registerInvoiceId String?
  invoiceDate       DateTime? @db.Date
  invoiceNumber     Int?
  minvoiceId        String?
  lastError         String?
  sendingAt         DateTime?

  createdById      Int?
  createdBy        User?     @relation("EinvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedById      Int?
  updatedBy        User?     @relation("EinvoiceUpdatedBy", fields: [updatedById], references: [id])
  updatedAt        DateTime  @updatedAt
  issuedById       Int?
  issuedBy         User?     @relation("EinvoiceIssuedBy", fields: [issuedById], references: [id])
  issuedAt         DateTime?
  numberEditedById Int?
  numberEditedBy   User?     @relation("EinvoiceNumberEditedBy", fields: [numberEditedById], references: [id])
  numberEditedAt   DateTime?

  @@unique([sellerTaxCode, symbolCode, invoiceNumber])
  @@index([branchId, businessDate])
  @@index([branchId, status, createdAt])
  @@index([orderId])
  @@index([sellerTaxCode, symbolCode, invoiceDate])
}
