# Disposable database for `npm run test:e2e` — it is reset on every run.
#   docker run -d --name kara502-pg -e POSTGRES_PASSWORD=postgres -p 5433:5432 postgres:16
#   docker exec kara502-pg psql -U postgres -c "create database karaoke_test"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/karaoke_test"
JWT_SECRET="test-secret"
JWT_REFRESH_SECRET="test-refresh-secret"
TZ=Asia/Ho_Chi_Minh
